<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Translucent Frosted Dark Slate Glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="135"
                android:startColor="#D9152536"
                android:centerColor="#CC223448"
                android:endColor="#DF122030"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle Top-Left Frosted Specular Sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="315"
                android:startColor="#24FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#1894A3B8"
                android:type="linear" />
            <stroke
                android:width="1.8dp"
                android:color="#9EFFFFFF" />
        </shape>
    </item>
</layer-list>
