<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Translucent Atmospheric Sky-Slate Frosted Glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="135"
                android:startColor="#D91B3147"
                android:centerColor="#CC2B455F"
                android:endColor="#DF182B3E"
                android:type="linear" />
        </shape>
    </item>
    <!-- Upper-Right Atmospheric Cloud Glow & Crisp Glass Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="45"
                android:startColor="#12FFFFFF"
                android:centerColor="#1EE2E8F0"
                android:endColor="#33FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1.8dp"
                android:color="#A6FFFFFF" />
        </shape>
    </item>
</layer-list>
